/* test_tokenizar_L_estres_200.jasb
   200 casos: textos largos (hasta ~3900 caracteres), modos 7/11/23/67/259 y bordes del buffer (~4096).
   Buffer interno del pipeline L: ver `vm_tokenizar_l_pipeline.inc`.
   Nota: en bucles usar `entero lim = N - 1` y `mientras i < lim` — `mientras i < N - 1` puede parsearse mal.
   Ejecutar: node .vscode/run-jasb.cjs sdk-dependiente/jas-compiler-c/tests/test_tokenizar_L_estres_200.jasb
   Exito: linea final "CASOS=200 FALLIOS=0" */
principal
    entero fallos = 0
    entero n_casos = 0

    /* Caso 0: un solo token gigante (cerca del limite de trabajo 4096 en vm_run_tokenizar_L). */
    texto mega = ""
    entero jm = 0
    mientras jm < 3900 hacer
        mega = concatenar(mega, "z")
        jm = jm + 1
    fin_mientras
    lista Lmega = tokenizar_L(mega, " ")
    si lista_tamano(Lmega) != 1 entonces
        fallos = fallos + 1
    fin_si
    n_casos = n_casos + 1

    /* Casos 1..99: cinco familias rotando (r = k % 5). */
    entero k = 0
    mientras k < 99 hacer
        entero r = k % 5

        si r == 0 entonces
            entero N = 30 + (k % 40) * 3
            entero lim_r0 = N - 1
            texto s = ""
            entero i = 0
            mientras i < lim_r0 hacer
                s = concatenar(s, "tok")
                s = concatenar(s, ",")
                i = i + 1
            fin_mientras
            s = concatenar(s, "tok")
            lista L = claves_L(s, ",")
            si lista_tamano(L) != N entonces
                fallos = fallos + 1
            fin_si
        sino si r == 1 entonces
            entero M = 25 + (k % 35) * 2
            entero lim_r1 = M - 1
            texto s2 = ""
            entero i2 = 0
            mientras i2 < lim_r1 hacer
                s2 = concatenar(s2, "w")
                s2 = concatenar(s2, "       ")
                i2 = i2 + 1
            fin_mientras
            s2 = concatenar(s2, "w")
            lista L2 = tokenizar_L(s2, " ")
            si lista_tamano(L2) != M entonces
                fallos = fallos + 1
            fin_si
        sino si r == 2 entonces
            entero P = 5 + (k % 12)
            entero lim_r2 = P - 1
            texto s3 = ""
            entero i3 = 0
            mientras i3 < lim_r2 hacer
                s3 = concatenar(s3, "uno")
                s3 = concatenar(s3, " ")
                i3 = i3 + 1
            fin_mientras
            s3 = concatenar(s3, "uno")
            lista L3 = tokenizar_L(s3, "", 7)
            entero esp_big = P + P - 1
            si lista_tamano(L3) != esp_big entonces
                fallos = fallos + 1
            fin_si
        sino si r == 3 entonces
            entero T = 400 + (k % 8) * 400
            texto s4 = ""
            entero i4 = 0
            mientras i4 < T hacer
                s4 = concatenar(s4, "q")
                i4 = i4 + 1
            fin_mientras
            lista L4 = tokenizar_L(s4, " ")
            si lista_tamano(L4) != 1 entonces
                fallos = fallos + 1
            fin_si
        sino
            entero U = 8 + (k % 10)
            entero lim_r4 = U - 1
            texto s5 = ""
            entero i5 = 0
            mientras i5 < lim_r4 hacer
                texto bloque = ""
                entero zb = 0
                mientras zb < 40 hacer
                    bloque = concatenar(bloque, "h")
                    zb = zb + 1
                fin_mientras
                s5 = concatenar(s5, bloque)
                s5 = concatenar(s5, ",")
                i5 = i5 + 1
            fin_mientras
            texto ult = ""
            entero zu = 0
            mientras zu < 40 hacer
                ult = concatenar(ult, "h")
                zu = zu + 1
            fin_mientras
            s5 = concatenar(s5, ult)
            lista L5 = claves_L(s5, ",")
            si lista_tamano(L5) != U entonces
                fallos = fallos + 1
            fin_si
        fin_si

        n_casos = n_casos + 1
        k = k + 1
    fin_mientras

    /* Casos 100..119: comas cortas con nx creciente (2..21 tokens). */
    entero jx = 0
    mientras jx < 20 hacer
        entero nx = 2 + jx
        entero limx = nx - 1
        texto sx = ""
        entero ix = 0
        mientras ix < limx hacer
            sx = concatenar(sx, "v")
            sx = concatenar(sx, ",")
            ix = ix + 1
        fin_mientras
        sx = concatenar(sx, "v")
        lista Lx = claves_L(sx, ",")
        si lista_tamano(Lx) != nx entonces
            fallos = fallos + 1
        fin_si
        n_casos = n_casos + 1
        jx = jx + 1
    fin_mientras

    /* Casos 120..139: modo 23 (unigramas + bigramas + trigramas), P palabras "tok" (P = 3..8). */
    entero j120 = 0
    mientras j120 < 20 hacer
        entero Pm = 3 + (j120 % 6)
        entero lim_p = Pm - 1
        texto s_tri = ""
        entero ip = 0
        mientras ip < lim_p hacer
            s_tri = concatenar(s_tri, "tok")
            s_tri = concatenar(s_tri, " ")
            ip = ip + 1
        fin_mientras
        s_tri = concatenar(s_tri, "tok")
        lista Lt = tokenizar_L(s_tri, "", 23)
        entero esp_tri = Pm + (Pm - 1) + (Pm - 2)
        si lista_tamano(Lt) != esp_tri entonces
            fallos = fallos + 1
        fin_si
        n_casos = n_casos + 1
        j120 = j120 + 1
    fin_mientras

    /* Casos 140..159: modo 11 (minusculas + colapsar + MIN2): M palabras "wx" (longitud 2). */
    entero j140 = 0
    mientras j140 < 20 hacer
        entero Mw = 5 + (j140 % 15)
        entero lim_w = Mw - 1
        texto s_wx = ""
        entero iw = 0
        mientras iw < lim_w hacer
            s_wx = concatenar(s_wx, "wx")
            s_wx = concatenar(s_wx, " ")
            iw = iw + 1
        fin_mientras
        s_wx = concatenar(s_wx, "wx")
        lista Lwx = tokenizar_L(s_wx, "", 11)
        si lista_tamano(Lwx) != Mw entonces
            fallos = fallos + 1
        fin_si
        n_casos = n_casos + 1
        j140 = j140 + 1
    fin_mientras

    /* Casos 160..179: modo 67 (strip puntuacion + colapsar + minusculas): un token tras normalizar. */
    entero j160 = 0
    mientras j160 < 20 hacer
        entero Lcore = 8 + (j160 % 8)
        texto s_pu = "   "
        entero ic = 0
        mientras ic < Lcore hacer
            s_pu = concatenar(s_pu, "m")
            ic = ic + 1
        fin_mientras
        s_pu = concatenar(s_pu, ",,!!  ")
        lista Lpu = tokenizar_L(s_pu, "", 67)
        si lista_tamano(Lpu) != 1 entonces
            fallos = fallos + 1
        fin_si
        n_casos = n_casos + 1
        j160 = j160 + 1
    fin_mientras

    /* Casos 180..199: modo 259 (minusculas + colapsar + stopwords builtin), tamanos esperados fijos. */
    entero j180 = 0
    mientras j180 < 20 hacer
        entero rsw = j180 % 4
        texto s_sw = ""
        entero ex_sw = 0
        si rsw == 0 entonces
            s_sw = "el perro"
            ex_sw = 1
        sino si rsw == 1 entonces
            s_sw = "sol y luna"
            ex_sw = 2
        sino si rsw == 2 entonces
            s_sw = "el sol brilla"
            ex_sw = 2
        sino
            s_sw = "el la los"
            ex_sw = 0
        fin_si
        lista Lsw = tokenizar_L(s_sw, "", 259)
        si lista_tamano(Lsw) != ex_sw entonces
            fallos = fallos + 1
        fin_si
        n_casos = n_casos + 1
        j180 = j180 + 1
    fin_mientras

    imprimir("CASOS=")
    imprimir(n_casos)
    imprimir(" FALLIOS=")
    imprimir(fallos)
    imprimir("\n")
fin_principal
