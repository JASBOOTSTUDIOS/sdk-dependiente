/* Regresión: paso 1 Unicode + pipeline L (utf8proc).
   Ver sdk-dependiente/docs/TOKENIZAR_L_PIPELINE_NATIVE.md para bits y orden.
   Archivo en UTF-8 (Straße, CAFÉ, café, ligadura ﬁ, NBSP U+00A0). */
principal
    entero fallos = 0

    /* Straße -> strasse (ß compat), un token */
    lista L1 = tokenizar_L("Straße", "", 1027)
    si lista_tamano(L1) != 1 entonces
        fallos = fallos + 1
    fin_si

    /* CAFÉ -> café (un token) */
    lista L2 = tokenizar_L("CAFÉ", "", 2051)
    si lista_tamano(L2) != 1 entonces
        fallos = fallos + 1
    fin_si

    /* Sin Unicode full: sigue funcionando ASCII */
    lista L3 = tokenizar_L("  HOLA  ", "", 3)
    si lista_tamano(L3) != 1 entonces
        fallos = fallos + 1
    fin_si

    /* NFKD + colapsar + lower: ligadura U+FB01 (UTF-8 EF AC 81) -> "film" un token */
    lista L4 = tokenizar_L("ﬁlm", "", 8195)
    si lista_tamano(L4) != 1 entonces
        fallos = fallos + 1
    fin_si

    /* NFKC + strip marcas + colapsar + lower: "café" -> cafe */
    lista L5 = tokenizar_L("café", "", 17411)
    si lista_tamano(L5) != 1 entonces
        fallos = fallos + 1
    fin_si

    /* NBSP (U+00A0): colapso Unicode (131072) + colapsar (2) + lower (1) = 131075 */
    lista L6 = tokenizar_L("hola mundo", "", 131075)
    si lista_tamano(L6) != 2 entonces
        fallos = fallos + 1
    fin_si

    /* Mismo texto: con modo 3 el separador vacio parte por espacio Unicode (NBSP), sin bit 131072 */
    lista L7 = tokenizar_L("hola mundo", "", 3)
    si lista_tamano(L7) != 2 entonces
        fallos = fallos + 1
    fin_si

    /* 1027+131072+262144 = 394243: NFKC + colapso WS Unicode + puntuacion -> espacio (paso 2 nativo) */
    lista L8 = tokenizar_L("x,y", "", 394243)
    si lista_tamano(L8) != 2 entonces
        fallos = fallos + 1
    fin_si

    /* Decimal con punto entre digitos se conserva (un token) */
    lista L9 = tokenizar_L("3.14", "", 394243)
    si lista_tamano(L9) != 1 entonces
        fallos = fallos + 1
    fin_si

    /* 918531 = 394243 | 524288: So (emoji) como frontera -> "a" y "b", sin token literal del emoji */
    lista L10 = tokenizar_L("a😀b", "", 918531)
    si lista_tamano(L10) != 2 entonces
        fallos = fallos + 1
    fin_si

    /* Mismo texto con dos modos: listas distintas (id de lista mezcla modo en la VM) */
    lista L11a = tokenizar_L("a😀b", "", 918531)
    lista L11b = tokenizar_L("a😀b", "", 394243)
    si lista_tamano(L11a) != 2 entonces
        fallos = fallos + 1
    fin_si
    si lista_tamano(L11b) != 1 entonces
        fallos = fallos + 1
    fin_si

    /* 4194304 COMMA_ASCII_LIST: coma entre dígitos ASCII parte (lista 1,2) */
    lista L12 = tokenizar_L("1,2", "", 4588547)
    si lista_tamano(L12) != 2 entonces
        fallos = fallos + 1
    fin_si

    /* 1048576 SM: operador + (Sm) como frontera */
    lista L13 = tokenizar_L("a+b", "", 1442819)
    si lista_tamano(L13) != 2 entonces
        fallos = fallos + 1
    fin_si

    /* 8388608 SEGMENT_GRAPHEME + paso 1+2 habitual: ASCII sigue bien */
    lista L14 = tokenizar_L("hola mundo", "", 8520707)
    si lista_tamano(L14) != 2 entonces
        fallos = fallos + 1
    fin_si

    /* S3: contracción en tokens adyacentes (de + el -> del) con CONTRACT */
    lista L15 = tokenizar_L("de\tel", "", 515)
    si lista_tamano(L15) != 1 entonces
        fallos = fallos + 1
    fin_si

    imprimir("UNICODE_NFKC_FALLIOS=")
    imprimir(fallos)
    imprimir("\n")
fin_principal
